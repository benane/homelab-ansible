# Ansible managed: Do NOT edit this file manually!

[Unit]
Description=VictoriaMetrics service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
LimitNOFILE=2097152
User={{ victoria_user }}
Group={{ victoria_user }}
ExecStart={{ victoria_binary_dir }}/victoria-metrics-prod \
  -storageDataPath={{ victoria_data_dir }} \
  -retentionPeriod={{ victoria_retention_period }} \
  -httpListenAddr=:{{ victoria_web_port }} \
  -promscrape.config={{ victoria_config_dir }}/scrape.yml

SyslogIdentifier={{ victoria_user }}
Restart=always

PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

ProtectSystem=strict
ReadWritePaths={{ victoria_data_dir }}

ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target